# ───────────────────────────────────────────────────────────────
# Check-in Desk — copy to .env.local
# Leave the Firebase project empty to run locally with an in-memory
# store (data resets when the server restarts).
# ───────────────────────────────────────────────────────────────

NEXT_PUBLIC_EVENT_NAME="DevFest Toronto 2026"

# --- Firebase (production) ---
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# --- Sign-in: one password per person, as "Name:password,Name:password" ---
# Names match case-insensitively. Passwords can't contain commas.
# If both are empty (local only), any name works with "admin" or "checkin".
ADMIN_USERS=             # leads (sync, export, undo, reset), e.g. Kritima:long-pass-1
STAFF_USERS=             # volunteers, e.g. Priya:pass-2,Sam:pass-3
SESSION_SECRET=change-me-to-a-long-random-string

# --- Bevy API ---
# Bevy issues API access per organization; ask your Bevy contact for the
# base URL, token format and attendee endpoint, then adjust these.
BEVY_API_BASE_URL=
BEVY_API_TOKEN=
BEVY_EVENT_ID=
BEVY_ATTENDEES_PATH=/api/v1/events/{eventId}/attendees
BEVY_AUTH_HEADER=Authorization
BEVY_AUTH_SCHEME=Token   # sent as "<scheme> <token>"; set empty to send the bare token
BEVY_PAGE_SIZE=200

# Optional: receive Bevy attendee webhooks at /api/bevy/webhook
BEVY_WEBHOOK_SECRET=

# Demo attendees + reset (default: on locally, off in Firebase mode)
# ALLOW_DEMO_DATA=true
