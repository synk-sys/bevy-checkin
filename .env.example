# ───────────────────────────────────────────────────────────────
# Check-in Desk — copy to .env.local
# Leave the Firebase block empty to run locally with an in-memory
# store and passcode sign-in (data resets when the server restarts).
# ───────────────────────────────────────────────────────────────

NEXT_PUBLIC_EVENT_NAME="DevFest Toronto 2026"

# --- Firebase (production) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
ADMIN_EMAILS=            # comma-separated Google accounts with admin access
STAFF_EMAILS=            # comma-separated volunteer accounts
STAFF_DOMAINS=           # optional: allow every verified account on these domains

# --- Local mode ---
STAFF_PASSCODE=checkin   # volunteers
ADMIN_PASSCODE=admin     # leads (sync, export, undo, reset)
SESSION_SECRET=change-me-to-a-long-random-string

# --- Bevy API ---
# Bevy issues API access per organization; ask your Bevy contact for the
# base URL, token format and attendee endpoint, then adjust these.
BEVY_API_BASE_URL=
BEVY_API_TOKEN=
BEVY_EVENT_ID=
BEVY_ATTENDEES_PATH=/api/v1/events/{eventId}/attendees
BEVY_AUTH_HEADER=Authorization
BEVY_AUTH_SCHEME=Token   # sent as "<scheme> <token>"; set empty to send the bare token
BEVY_PAGE_SIZE=200

# Optional: receive Bevy attendee webhooks at /api/bevy/webhook
BEVY_WEBHOOK_SECRET=

# Demo attendees + reset (default: on locally, off in Firebase mode)
# ALLOW_DEMO_DATA=true
