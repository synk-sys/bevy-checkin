# ───────────────────────────────────────────────────────────────
# Check-in Desk — copy to .env.local
# Leave DATABASE_URL empty to run locally with an in-memory
# store (data resets when the server restarts).
# ───────────────────────────────────────────────────────────────

NEXT_PUBLIC_EVENT_NAME="DevFest Toronto 2026"

# --- Supabase (production) ---
# Supabase dashboard → Connect → "Transaction pooler" connection string (port 6543),
# with your database password filled in. The app creates its table on first use.
DATABASE_URL=

# --- Sign-in, as "Name:password,Name:password" ---
# Admins sign in by name; volunteers sign in as a desk ("Desk 1" … "Desk 6"), one password per desk.
# Names match case-insensitively. Passwords can't contain commas.
# If both are empty (local only), any name or desk works with "admin" or "checkin".
ADMIN_USERS=             # leads (import, export, undo, reset), e.g. Kritima:long-pass-1
STAFF_USERS=             # desks, e.g. Desk 1:tulip-1,Desk 2:maple-2,Desk 3:cedar-3,Desk 4:birch-4,Desk 5:aspen-5,Desk 6:willow-6
SESSION_SECRET=change-me-to-a-long-random-string

# --- Bevy API ---
# Bevy issues API access per organization; ask your Bevy contact for the
# base URL, token format and attendee endpoint, then adjust these.
BEVY_API_BASE_URL=
BEVY_API_TOKEN=
BEVY_EVENT_ID=
BEVY_ATTENDEES_PATH=/api/v1/events/{eventId}/attendees
BEVY_AUTH_HEADER=Authorization
BEVY_AUTH_SCHEME=Token   # sent as "<scheme> <token>"; set empty to send the bare token
BEVY_PAGE_SIZE=200

# Optional: receive Bevy attendee webhooks at /api/bevy/webhook
BEVY_WEBHOOK_SECRET=

# Demo attendees + reset (default: on without a database, off with DATABASE_URL)
# ALLOW_DEMO_DATA=true
