rules_version = '2';

// Attendee data is personal information. Every read and write goes through
// the Next.js server (Firebase Admin SDK), which enforces staff/admin roles.
// Browsers never talk to Firestore directly.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
